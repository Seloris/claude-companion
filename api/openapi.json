    "parameters": {}
  },
  "paths": {
    "/v1/workspaces": {
      "get": {
        "summary": "Workspaces, most recent activity first, with their totals",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            },
            "required": false,
            "name": "includeScratch",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The workspaces",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspaceId}": {
      "get": {
        "summary": "A workspace and its sessions, most recent first",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "required": true,
            "name": "workspaceId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{sessionId}": {
      "get": {
        "summary": "A session with its token usage per model, its activity, its subagents and its tools",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/dashboard": {
      "get": {
        "summary": "Statistics of a period, over all workspaces or one: totals, rankings and activity per day",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/DashboardPeriod"
            },
            "required": false,
            "name": "period",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "required": false,
            "name": "workspaceId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            },
            "required": false,
            "name": "includeScratch",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "default": "UTC"
            },
            "required": false,
            "name": "timeZone",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The dashboard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Liveness of the API",
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "status",
                    "time"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/refresh": {
      "get": {
        "summary": "Whether a refresh runs, and the report of the last one",
        "responses": {
          "200": {
            "description": "The refresh status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Start a refresh, or return the one already running; a full refresh re-reads every log file",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/RefreshMode"
            },
            "required": false,
            "name": "mode",
            "in": "query"
          }
        ],
        "responses": {
          "202": {
            "description": "The refresh runs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshStatus"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/refresh/schedule": {
      "get": {
        "summary": "The interval of the periodic refresh",
        "responses": {
          "200": {
            "description": "The schedule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshSchedule"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Choose the interval of the periodic refresh; it applies at once and survives a restart",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSchedule"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved schedule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshSchedule"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/live": {
      "get": {
        "summary": "The Claude Code sessions running on this machine, grouped by workspace",
        "responses": {
          "200": {
            "description": "The live state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveState"
                }
              }
            }
          }
        }
      }
    },
    "/v1/retention": {
      "get": {
        "summary": "Claude Code's log retention, the oldest log, and the unread logs about to be deleted",
        "responses": {
          "200": {
            "description": "The log retention status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogRetentionStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
