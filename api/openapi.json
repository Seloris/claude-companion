          "idle"
        ]
      },
      "CurrentActivity": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "tool"
                ]
              },
              "toolName": {
                "type": "string"
              },
              "skill": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "since": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "kind",
              "toolName",
              "skill",
              "since"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "agent"
                ]
              },
              "agentType": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "skill": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "since": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "kind",
              "agentType",
              "description",
              "skill",
              "since"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "subagents"
                ]
              },
              "skill": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "since": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "kind",
              "skill",
              "since"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "thinking"
                ]
              },
              "skill": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "since": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "kind",
              "skill",
              "since"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "RunningSubagent": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string"
          },
          "agentType": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "currentTool": {
            "type": [
              "string",
              "null"
            ]
          },
          "since": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "agentId",
          "agentType",
          "description",
          "currentTool",
          "since"
        ]
      },
      "LogRetentionStatus": {
        "type": "object",
        "properties": {
          "retentionDays": {
            "type": "integer"
          },
          "isDefault": {
            "type": "boolean"
          },
          "oldestLogAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "archivedSessionCount": {
            "type": "integer"
          },
          "unreadAtRisk": {
            "type": "object",
